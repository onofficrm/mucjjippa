# 프로덕션 환경 — 비밀값은 시크릿 매니저/CI에만 보관
NODE_ENV=production
APP_ENV=production

POSTGRES_USER=mucjjippa
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_DB_PASSWORD
POSTGRES_DB=mucjjippa
WEB_PORT=80

JWT_ACCESS_SECRET=CHANGE_ME_PRODUCTION_ACCESS_SECRET_MIN_32
JWT_REFRESH_SECRET=CHANGE_ME_PRODUCTION_REFRESH_SECRET_MIN_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=https://game.example.com

LOG_LEVEL=info
LOG_DIR=/app/logs
EXPOSE_API_DOCS=false
RUN_SEED=false
SEED_MODE=catalog
SKIP_MIGRATE=false

VITE_API_BASE_URL=/api
VITE_WS_URL=
VITE_USE_MOCK=false

# SENTRY_DSN=https://xxxx@sentry.io/xxxx
