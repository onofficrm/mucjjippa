# 스테이징 환경
NODE_ENV=production
APP_ENV=staging

POSTGRES_USER=mucjjippa
POSTGRES_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD
POSTGRES_DB=mucjjippa_staging
WEB_PORT=8080

JWT_ACCESS_SECRET=CHANGE_ME_STAGING_ACCESS_SECRET_MIN_32
JWT_REFRESH_SECRET=CHANGE_ME_STAGING_REFRESH_SECRET_MIN_32
CORS_ORIGIN=https://staging.example.com

LOG_LEVEL=info
LOG_DIR=/app/logs
EXPOSE_API_DOCS=true
RUN_SEED=true
SEED_MODE=catalog
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

VITE_API_BASE_URL=/api
VITE_WS_URL=
VITE_USE_MOCK=false

# SENTRY_DSN=https://xxxx@sentry.io/xxxx
