{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "npm run test --prefix server",
    "test:unit": "npm run test:unit --prefix server",
    "test:integration": "npm run test:integration --prefix server",
    "test:concurrency": "npm run test:concurrency --prefix server",
    "test:e2e:api": "npm run test:e2e --prefix server",
    "test:e2e": "playwright test",
    "test:all": "npm run test --prefix server && playwright test",
    "docker:up": "docker compose --env-file deploy/env/development.env.example up --build",
    "docker:down": "docker compose down",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file deploy/env/production.env.example up -d --build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io-client": "^4.8.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
