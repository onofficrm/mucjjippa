# Frontend (Vite)
# 전송 모드:
#   미지정(권장)     → 인증/유저/지갑/상점/1:1매치/300P전략/토너먼트는 실제 API·Socket, 광고 SDK만 Mock
#   VITE_USE_MOCK=true  → 전부 Mock
#   VITE_USE_MOCK=false → 전부 HTTP
# VITE_USE_MOCK=
VITE_API_BASE_URL=http://localhost:4000/api
VITE_WS_URL=http://localhost:4000
VITE_APP_ENV=development

# Backend / infra — 실제 값은 server/.env 에서 관리합니다. (여기에는 비밀값을 넣지 마세요)
# Docker Compose 환경 예시는 deploy/env/*.env.example 참고
# DATABASE_URL=
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# REDIS_URL=
# CORS_ORIGIN=http://localhost:3000
