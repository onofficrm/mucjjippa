{
  "name": "mucjjippa-pang-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "묵찌빠 팡 백엔드 — Fastify + Prisma + PostgreSQL + Redis",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:concurrency": "vitest run tests/concurrency",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "check:rps": "tsx src/modules/match/rps.check.ts",
    "check:strategy": "tsx src/modules/match/strategy.check.ts",
    "check:tournament": "tsx src/modules/tournament/tournament.check.ts",
    "check": "npm run check:rps && npm run check:strategy && npm run check:tournament",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:catalog": "SEED_MODE=catalog tsx prisma/seed.ts",
    "db:seed:demo": "SEED_MODE=demo tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.1",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^3.2.4",
    "prisma": "^6.12.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
