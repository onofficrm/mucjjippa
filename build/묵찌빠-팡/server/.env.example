# 묵찌빠 팡 서버 환경변수 예시
# 실제 비밀값은 커밋하지 마세요. 이 파일을 복사해 .env 를 만드세요.
#   cp .env.example .env

NODE_ENV=development
APP_ENV=development
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api
API_VERSION=v1

# PostgreSQL (Prisma)
# Homebrew 기본 롤은 보통 macOS 사용자명입니다.
# 예: postgresql://gimhaseong@localhost:5432/mucjjippa?schema=public
DATABASE_URL=postgresql://YOUR_USER@localhost:5432/mucjjippa?schema=public

# Redis (매칭 큐·세션 캐시)
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — Vite 개발 서버 (credentials: cookie 전달용)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001

# 로그 / 시크릿
LOG_LEVEL=info
# LOG_DIR=/var/log/mucjjippa
# SENTRY_DSN=

# Seed — catalog(운영 카탈로그) | demo(개발 데모 유저 포함)
SEED_MODE=demo
SEED_ADMIN_PASSWORD=Admin1234!
SEED_USER_PASSWORD=User1234!

# 프로덕션에서 OpenAPI UI 강제 노출 시
# EXPOSE_API_DOCS=true
